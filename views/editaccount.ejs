
<!DOCTYPE html>
<html>
<head>
    <title><%= title %></title>
    <link rel="stylesheet" href="/stylesheets/style.css">
    <meta name="viewport" content="width=device-width, initial-scale=1">
</head>
<body>

    <header class="site-header">
        <div class="header-brand">
            <img src="/images/db_logo.png" alt="DB Financial Services Logo" class="site-logo">

            <div class="header-title">
                DB Financial Services
            </div>
        </div>

        <nav class="main-nav">
            <a href="/">Home</a>
            <a href="/aboutus">About Us</a>
            <a href="/contact">Contact</a>
            <a href="/newaccount">New Account</a>
            <a href="/viewaccount">View Accounts</a>
        </nav>
    </header>

    <main class="account-form-container">
        <h2>Edit Account</h2>

        <form action="/editaccount/<%= account._id %>" method="POST">

            <label for="accountName">Account Holder Name:</label>
            <input
                type="text"
                id="accountName"
                name="accountName"
                value="<%= account.accountName %>"
                required
            >

            <label for="accountType">Account Type:</label>
            <select id="accountType" name="accountType" required>
                <option value="Chequing" <%= account.accountType === 'Chequing' ? 'selected' : '' %>>Chequing</option>
                <option value="Savings" <%= account.accountType === 'Savings' ? 'selected' : '' %>>Savings</option>
                <option value="Business" <%= account.accountType === 'Business' ? 'selected' : '' %>>Business</option>
            </select>

            <label for="balance">Account Balance ($):</label>
            <input
                type="number"
                id="balance"
                name="balance"
                value="<%= account.balance %>"
                min="0"
                step="0.01"
                required
            >

            <button type="submit">Save Changes</button>

        </form>
    </main>

</body>
</html>
